# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# variant write artifacts: the rolling backup an atomic write leaves next to a
# variant, and an in-progress write that a crash did not clean up
/data/*.bak
/data/*.tmp

# Resume content is personal data: real names, phone numbers and email
# addresses. The app seeds its own variant on a fresh clone (see
# ensureFirstVariant in lib/variants.ts), so nothing here needs to be
# committed. example.json is the one exception: placeholder content only.
/data/*.json
!/data/example.json

# local tooling state, not part of the project
/.atl/
/.codegraph/
